# Veilige lokale voorbeeldwaarde. Gebruik in productie een unieke secret en beheerde database.
DATABASE_URL="postgresql://workmatchr:workmatchr_dev@localhost:5432/workmatchr?schema=public"
KNOWLEDGE_SOURCE_ROOT="local-sources/knowledge"
KNOWLEDGE_SOURCE_MANIFEST="local-sources/knowledge/knowledge-sources.local.json"
BETTER_AUTH_SECRET="vervang-door-minimaal-32-willekeurige-tekens"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY=""
AUTH_EMAIL_FROM="WorkMatchr <account@workmatchr.nl>"

# Optionele AI Intake Classifier. Zonder API-sleutel blijft de intake
# volledig werken via de deterministische onderwerpkeuze.
OPENAI_API_KEY=""
OPENAI_AI_INTAKE_MODEL="gpt-5.2"
OPENAI_AI_INTAKE_TIMEOUT_MS="10000"

# Alleen lokale developmentopslag. Productie vereist later een object-storageprovider.
ORGANIZATION_LOGO_STORAGE="local"

# Uitsluitend voor lokale development- en testomgevingen. Nooit inschakelen in productie.
ENABLE_TEST_ACCOUNT_SWITCHER="false"

# Mollie-betalingen. Gebruik in productie uitsluitend beheerde Vercel-environmentwaarden.
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_BASE_URL="http://localhost:3000"
MOLLIE_REDIRECT_BASE_URL="http://localhost:3000"
FINANCIAL_MAINTENANCE_SECRET="replace-with-at-least-32-random-characters"
