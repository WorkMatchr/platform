model User {
  id                                 String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                              String                                 @unique
  displayName                        String?
  emailVerified                      Boolean                                @default(false)
  image                              String?
  twoFactorEnabled                   Boolean                                @default(false)
  platformRole                       PlatformRole                           @default(USER)
  accountType                        AccountType?
  status                             UserStatus                             @default(INVITED)
  createdAt                          DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime                               @updatedAt @db.Timestamptz(3)
  archivedAt                         DateTime?                              @db.Timestamptz(3)
  createdByUserId                    String?                                @db.Uuid
  blockedAt                          DateTime?                              @db.Timestamptz(3)
  blockedByUserId                    String?                                @db.Uuid
  deletionRequestedAt                DateTime?                              @db.Timestamptz(3)
  deletionRequestedByUserId          String?                                @db.Uuid
  deletionEffectiveAt                DateTime?                              @db.Timestamptz(3)
  anonymizedAt                       DateTime?                              @db.Timestamptz(3)
  retentionPurgeAt                   DateTime?                              @db.Timestamptz(3)
  lifecycleReasonCode                String?                                @db.VarChar(80)
  lifecycleReasonNote                String?                                @db.VarChar(500)
  migrationClassification            UserMigrationClassification?
  createdByUser                      User?                                  @relation("UserProvisioningCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers                       User[]                                 @relation("UserProvisioningCreator")
  blockedByUser                      User?                                  @relation("UserBlockActor", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  blockedUsers                       User[]                                 @relation("UserBlockActor")
  deletionRequestedByUser            User?                                  @relation("UserDeletionRequestActor", fields: [deletionRequestedByUserId], references: [id], onDelete: SetNull)
  deletionRequestedUsers             User[]                                 @relation("UserDeletionRequestActor")
  memberships                        OrganizationMembership[]
  provisioningEventsAsSubject        AccountProvisioningEvent[]             @relation("AccountProvisioningSubject")
  provisioningEventsAsActor          AccountProvisioningEvent[]             @relation("AccountProvisioningActor")
  organizationProvisioningEvents     OrganizationProvisioningEvent[]        @relation("OrganizationProvisioningActor")
  membershipEventsAsSubject          OrganizationMembershipEvent[]          @relation("OrganizationMembershipEventSubject")
  membershipEventsAsActor            OrganizationMembershipEvent[]          @relation("OrganizationMembershipEventActor")
  deletedAccountRetention            DeletedAccountRetention?
  approvedProviderProfiles           ProviderProfile[]                      @relation("ProviderProfileApprover")
  verifiedProviderCertificates       ProviderCertification[]                @relation("CertificationVerifier")
  createdIntakes                     Intake[]                               @relation("IntakeCreator")
  submittedIntakes                   Intake[]                               @relation("IntakeSubmitter")
  updatedIntakeAnswers               IntakeAnswer[]                         @relation("IntakeAnswerUpdater")
  changedIntakeAnswerRevisions       IntakeAnswerRevision[]                 @relation("IntakeAnswerRevisionActor")
  changedIntakeStatuses              IntakeStatusHistory[]                  @relation("IntakeStatusHistoryActor")
  createdAssignments                 Assignment[]                           @relation("AssignmentCreator")
  publishedAssignments               Assignment[]                           @relation("AssignmentPublisher")
  changedAssignmentStatuses          AssignmentStatusHistory[]              @relation("AssignmentStatusHistoryActor")
  changedAssignmentRevisions         AssignmentRevision[]                   @relation("AssignmentRevisionActor")
  selectedProviderSelections         AssignmentProviderSelection[]          @relation("ProviderSelectionActor")
  assignmentResolutions              AssignmentResolution[]                 @relation("AssignmentResolutionActor")
  adminActions                       AdminActionLog[]                       @relation("AdminActionActor")
  authoredAdminCommunications        AdminCommunication[]                   @relation("AdminCommunicationAuthor")
  createdCreditTransactions          CreditTransaction[]                    @relation("CreditTransactionActor")
  createdFinancialPurchases          FinancialPurchase[]                    @relation("FinancialPurchaseActor")
  approvedFinancialRefunds           FinancialRefund[]                      @relation("FinancialRefundApprover")
  financialEvents                    FinancialEvent[]                       @relation("FinancialEventActor")
  createdDiscountCodes               DiscountCode[]                         @relation("DiscountCodeCreator")
  decidedStarterBenefitReviews       StarterBenefitReview[]                 @relation("StarterBenefitReviewer")
  grantedStarterBenefits             StarterBenefitGrant[]                  @relation("StarterBenefitGrantActor")
  sessions                           Session[]                              @relation("SessionActor")
  impersonatedSessions               Session[]                              @relation("SessionEffectiveUser")
  accounts                           Account[]
  twoFactors                         TwoFactor[]
  providerPermissionSubjects         ProviderPlatformPermissionGrant[]      @relation("ProviderPermissionSubject")
  providerPermissionGranters         ProviderPlatformPermissionGrant[]      @relation("ProviderPermissionGranter")
  providerPermissionRevokers         ProviderPlatformPermissionRevocation[] @relation("ProviderPermissionRevoker")
  providerTermAcceptances            ProviderTermAcceptance[]
  providerVerificationReviews        ProviderVerificationReview[]           @relation("ProviderVerificationReviewer")
  providerQualificationReviews       ProviderQualificationDecision[]        @relation("ProviderQualificationReviewer")
  providerQualificationApprovals     ProviderQualificationDecision[]        @relation("ProviderQualificationApprover")
  providerReadinessAssessments       ProviderReadinessAssessment[]
  providerSelectabilityAssessments   ProviderSelectabilityAssessment[]
  providerBlocks                     ProviderBlock[]                        @relation("ProviderBlockActor")
  providerBlockReviews               ProviderBlock[]                        @relation("ProviderBlockReviewer")
  providerBlockReleases              ProviderBlockRelease[]                 @relation("ProviderBlockReleaseActor")
  providerBlockReleaseReviews        ProviderBlockRelease[]                 @relation("ProviderBlockReleaseReviewer")
  providerProjections                TrustedProviderProjection[]
  confirmedProviderCapacities        ProviderCapacitySnapshot[]             @relation("ProviderCapacityConfirmer")
  providerProfessionalIdentities     ProviderProfessionalIdentityRevision[] @relation("ProviderProfessionalIdentityActor")
  createdProviderCandidates          ProviderDossierCandidate[]             @relation("ProviderDossierCandidateActor")
  submittedProviderDossiers          ProviderDossierSubmission[]            @relation("ProviderDossierSubmitter")
  providerDossierHistory             ProviderDossierSubmissionHistory[]     @relation("ProviderDossierHistoryActor")
  openedProviderReviewCases          ProviderDossierReviewCase[]            @relation("ProviderDossierReviewCaseOpener")
