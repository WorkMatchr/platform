  editorialNote           String?                          @db.VarChar(1500)
  proposedAccessTier      KnowledgeAccessTier?
  assignedToId            String?                          @db.Uuid
  lastEditedById          String?                          @db.Uuid
  completedById           String?                          @db.Uuid
  dueAt                   DateTime?                        @db.Timestamptz(3)
  deferredUntil           DateTime?                        @db.Timestamptz(3)
  nextReviewAt            DateTime?                        @db.Timestamptz(3)
  startedAt               DateTime?                        @db.Timestamptz(3)
  completedAt             DateTime?                        @db.Timestamptz(3)
  createdAt               DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                         @updatedAt @db.Timestamptz(3)
  claim                   KnowledgeClaim                   @relation(fields: [claimId], references: [id], onDelete: Restrict)
  assignedTo              User?                            @relation("KnowledgeReviewTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastEditedBy            User?                            @relation("KnowledgeReviewTaskEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  completedBy             User?                            @relation("KnowledgeReviewTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  decisions               KnowledgeReviewDecision[]
  sourceReferences        KnowledgeReviewSourceReference[]
  validations             KnowledgeValidation[]
  improvementReports      KnowledgeImprovementReport[]

  @@index([status, priority, dueAt])
  @@index([requiresHumanAction, status, priority, dueAt])
  @@index([controlExceptionType, requiresHumanAction])
  @@index([entityType, entityId])
  @@index([claimId, status])
  @@index([assignedToId, status])
}

model KnowledgeReviewDecision {
  id                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewTaskId            String                      @db.Uuid
  sequence                Int
  decisionType            KnowledgeReviewDecisionType
  previousStatus          KnowledgeReviewTaskStatus
  nextStatus              KnowledgeReviewTaskStatus
  actorUserId             String                      @db.Uuid
  reason                  String?                     @db.VarChar(1500)
  proposedStatement       String?                     @db.VarChar(1500)
  substantiveNotes        String?                     @db.VarChar(1500)
  practicalNuance         String?                     @db.VarChar(1500)
  applicabilityConditions String?                     @db.VarChar(1500)
  exceptions              String?                     @db.VarChar(1500)
  editorialNote           String?                     @db.VarChar(1500)
  proposedAccessTier      KnowledgeAccessTier?
  nextReviewAt            DateTime?                   @db.Timestamptz(3)
  createdAt               DateTime                    @default(now()) @db.Timestamptz(3)
  reviewTask              KnowledgeReviewTask         @relation(fields: [reviewTaskId], references: [id], onDelete: Restrict)
  actorUser               User                        @relation("KnowledgeReviewDecisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([reviewTaskId, sequence])
  @@index([reviewTaskId, createdAt])
  @@index([actorUserId, createdAt])
}

model KnowledgeReviewSourceReference {
  id                    String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewTaskId          String                               @db.Uuid
  claimId               String                               @db.Uuid
  action                KnowledgeReviewSourceReferenceAction @default(ADDED)
  sourceVersionId       String?                              @db.Uuid
  withdrawsReferenceId  String?                              @unique @db.Uuid
  sourceType            KnowledgeSourceType
  title                 String                               @db.VarChar(300)
  publisher             String?                              @db.VarChar(200)
  urlOrReference        String?                              @db.VarChar(1000)
  publicationDate       DateTime?                            @db.Date
  checkedAt             DateTime?                            @db.Date
  authorityLevel        KnowledgeAuthorityLevel
  isPrimary             Boolean                              @default(false)
  sourceFamily          String                               @db.VarChar(120)
  supportType           KnowledgeSupportType
  actorUserId           String                               @db.Uuid
  createdAt             DateTime                             @default(now()) @db.Timestamptz(3)
  reviewTask            KnowledgeReviewTask                  @relation(fields: [reviewTaskId], references: [id], onDelete: Restrict)
  claim                 KnowledgeClaim                       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  sourceVersion         KnowledgeSourceVersion?              @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  withdrawsReference    KnowledgeReviewSourceReference?      @relation("KnowledgeReviewSourceWithdrawal", fields: [withdrawsReferenceId], references: [id], onDelete: Restrict)
  withdrawnByReferences KnowledgeReviewSourceReference[]     @relation("KnowledgeReviewSourceWithdrawal")
  actorUser             User                                 @relation("KnowledgeReviewSourceReferenceActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([reviewTaskId, createdAt])
  @@index([claimId, supportType])
  @@index([sourceVersionId])
  @@index([actorUserId, createdAt])
}

model KnowledgeImprovementReport {
  id                  String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId             String                           @db.Uuid
  reviewTaskId        String                           @db.Uuid
  reportType          KnowledgeImprovementReportType
  explanation         String                           @db.VarChar(1500)
  proposedImprovement String?                          @db.VarChar(1500)
  sourceReference     String?                          @db.VarChar(1000)
  reporterUserId      String                           @db.Uuid
  status              KnowledgeImprovementReportStatus @default(NEW)
  version             Int                              @default(1)
  handledByUserId     String?                          @db.Uuid
  handledAt           DateTime?                        @db.Timestamptz(3)
  resolution          String?                          @db.VarChar(1500)
  createdAt           DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                         @updatedAt @db.Timestamptz(3)
  claim               KnowledgeClaim                   @relation(fields: [claimId], references: [id], onDelete: Restrict)
  reviewTask          KnowledgeReviewTask              @relation(fields: [reviewTaskId], references: [id], onDelete: Restrict)
  reporterUser        User                             @relation("KnowledgeImprovementReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  handledByUser       User?                            @relation("KnowledgeImprovementHandler", fields: [handledByUserId], references: [id], onDelete: Restrict)

  @@index([claimId, status, createdAt])
  @@index([reviewTaskId, status])
  @@index([reporterUserId, createdAt])
  @@index([status, createdAt])
}

model KnowledgeAuditEvent {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType   KnowledgeAuditEventType
  entityType  String                  @db.VarChar(80)
  entityId    String?                 @db.Uuid
  actorUserId String?                 @db.Uuid
  actorType   String                  @db.VarChar(80)
  result      String                  @db.VarChar(80)
  reason      String?                 @db.VarChar(1000)
  metadata    Json?
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  actorUser   User?                   @relation("KnowledgeAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
}
